#!/usr/bin/env bash
# Put the DCO sign-off on every commit, because `format.signoff` does not.
#
# That is the trap this file exists to close. `git config format.signoff true`
# was already set here and reads as "sign-offs are on", but that setting only
# applies to `git format-patch`. `git commit` does not look at it: without `-s`
# no trailer appears, and that is testable --
#
#   git init t && cd t && git config format.signoff true
#   git commit --allow-empty -m x   ->  no Signed-off-by
#   git commit --allow-empty -s -m x ->  one
#
# A setting that is on and does nothing is worse than one that is off: the
# pre-push gate refuses unsigned commits written after 03-09-2026 07:30:44Z, and
# whoever reads the config concludes it is handled.
#
# `--if-exists doNothing` makes this idempotent, so a `git commit --amend` or a
# manual `-s` does not produce a second line.
#
# NOT `add`: that is exactly what the name suggests, and it appends the trailer
# every time -- measured as 1 line after the commit, 2 after an amend, 3 after
# two. This comment used to say `add` while the code did `doNothing`. That is
# more dangerous than a stale comment: reconciling code and comment -- the
# obvious move when they disagree -- builds the bug in. The test held the
# behaviour; nothing held the comment.
set -euo pipefail

msg_file="$1"
msg_source="${2:-}"

# On a merge or a squash git writes the message itself. A sign-off there should
# come from the person performing it, and they get one on their own commit
# through this same hook. Only `message`, `template` and an empty source get one:
# those are the cases where something new is actually being recorded.
case "$msg_source" in
  merge|squash) exit 0 ;;
esac

name=$(git config user.name || true)
email=$(git config user.email || true)
if [ -z "$name" ] || [ -z "$email" ]; then
  echo "prepare-commit-msg: user.name or user.email missing, no sign-off written" >&2
  exit 0
fi

git interpret-trailers --in-place --if-exists doNothing \
  --trailer "Signed-off-by: $name <$email>" "$msg_file"
