#!/usr/bin/env bash
# Pre-push gate: block pushes that don't pass the CI sanity+lint gates.
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass intentionally:    PRE_PUSH_SKIP=1 git push ...   (or git push --no-verify)
[ "${PRE_PUSH_SKIP:-0}" = "1" ] && { echo "[pre-push] skipped (PRE_PUSH_SKIP=1)"; exit 0; }
# The commit-msg hook only sees messages written in a clone that has it
# installed. Everything else arrives with its message already fixed: commits
# from before the hook existed, a rebase, a cherry-pick, `--no-verify`, or a
# clone where nobody ran `git config core.hooksPath .githooks`. This is the
# layer that catches those, and it is the last one before the message is
# published -- after a merge the only remedy is a history rewrite.
if [ -f scripts/ci/geen_interne_zaken.py ]; then
  BOVEN="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
  if [ -n "$BOVEN" ]; then
    # `--bereik` is the guard's own calling convention: any dash-prefixed
    # first argument makes it read the SECOND as a revision range, because a
    # bare first argument means "this file holds one message".
    if ! python3 scripts/ci/geen_interne_zaken.py --bereik "${BOVEN}..HEAD"; then
      echo "[pre-push] BLOCKED: a commit message names something internal." >&2
      echo "  Rewrite the messages before pushing -- once merged, only a" >&2
      echo "  history rewrite removes them. See the guard's output above." >&2
      exit 1
    fi
  fi
  # No upstream: nothing to compare against, and inventing a base here would
  # judge a range nobody is pushing. The commit-msg hook already covered these
  # messages, and CI judges the branch once it exists remotely.
fi

# WHICH LANE, and git already knows. A pre-push hook is handed one line per ref
# on stdin -- `<local ref> <local sha> <remote ref> <remote sha>` -- so the
# destination is a fact here, not a guess from the branch name. A branch called
# master that is being pushed somewhere else is not a landing, and a detached
# HEAD pushed to refs/heads/master is.
#
# stdin is consumed by reading it, and anything below that wanted those lines
# would silently get none. Nothing below does; if that changes, keep the lines.
BAAN=--fast
while read -r _lokaal_ref _lokaal_sha verre_ref _verre_sha; do
  case "$verre_ref" in refs/heads/master) BAAN=--full ;; esac
done
if [ "$BAAN" = --full ]; then
  echo "[pre-push] pushing to master — running the FULL local CI gate (this compiles)…"
else
  echo "[pre-push] running the fast local CI gate; the compiling gates run on the push to master…"
fi

bash scripts/ci/local_ci_gate.sh "$BAAN"
rc=$?
if [ $rc -eq 3 ]; then
  # Its own message, because these two states are not the same thing and used to
  # print the same sentence. A gate that fails has judged your code; a disk below
  # the floor has judged nothing at all, and telling the reader "the gate failed"
  # sends them to look for a defect that does not exist.
  echo "[pre-push] BLOCKED: not enough disk to measure anything — see the headroom" >&2
  echo "  report above for what can be swept. NOTHING WAS CHECKED: this is not a" >&2
  echo "  verdict on your code. PRE_PUSH_SKIP=1 would push code no gate has read." >&2
  exit 1
fi
if [ $rc -ne 0 ]; then
  echo "[pre-push] BLOCKED: local CI gate failed. Fix, or 'PRE_PUSH_SKIP=1 git push' to override." >&2
  exit 1
fi
