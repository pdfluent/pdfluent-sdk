[Unit]
Description=Delete Hetzner CI instances that are idle and past their billed hour
Documentation=https://github.com/pdfluent/pdfluent-internal/issues/279
After=network-online.target

[Service]
Type=oneshot
# Same lock the provisioning script takes, so claiming and reaping cannot
# interleave (#280). The script re-execs under it; this is belt and braces.
Environment=PDFLUENT_INSTANCE_LOCK=/var/tmp/pdfluent-instances.lock
Environment=GITHUB_REPOSITORY=jasperdew/xfa-native-rust
EnvironmentFile=/etc/pdfluent/reaper.env
WorkingDirectory=/opt/pdfluent/xfa
ExecStart=/usr/bin/python3 scripts/ci/sweep_idle_instances.py
# A sweep that cannot finish must not wedge the timer.
TimeoutStartSec=600
