[Unit]
Description=Reap idle Hetzner CI instances every 15 minutes
Documentation=https://github.com/pdfluent/pdfluent-internal/issues/279

[Timer]
# GitHub's own */30 schedule fired twice in a day. This machine is always on
# and is the only one that provisions, so it is the right place for the clock.
# OnCalendar, not OnBootSec/OnUnitActiveSec. Persistent= only catches up
# missed runs for calendar timers; on monotonic ones it is accepted and does
# nothing, so the config would have claimed a property it did not have -- the
# exact failure this whole timer exists to replace.
OnCalendar=*:0/15
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
