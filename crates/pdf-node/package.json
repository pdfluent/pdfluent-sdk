{
  "name": "@xfa-engine/pdf-node",
  "version": "1.0.0-beta.1",
  "description": "Enterprise PDF SDK for Node.js — rendering, text extraction, forms, annotations, redaction, encryption, and PDF/A compliance.",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "napi": {
    "binaryName": "pdf-node",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">= 18"
  },
  "scripts": {
    "build": "napi build --release --platform",
    "build:debug": "napi build --platform",
    "test": "jest tests/",
    "prepublishOnly": "napi prepublish -t npm"
  },
  "keywords": [
    "pdf",
    "render",
    "forms",
    "xfa",
    "acroform",
    "text-extraction",
    "pdf-a",
    "compliance",
    "annotations",
    "redaction",
    "encryption",
    "signature",
    "rust",
    "napi",
    "high-performance"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jasperdew/xfa-native-rust"
  },
  "homepage": "https://github.com/jasperdew/xfa-native-rust#readme",
  "bugs": {
    "url": "https://github.com/jasperdew/xfa-native-rust/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@xfa-engine/pdf-node-darwin-arm64": "1.0.0-beta.1",
    "@xfa-engine/pdf-node-darwin-x64": "1.0.0-beta.1",
    "@xfa-engine/pdf-node-linux-arm64-gnu": "1.0.0-beta.1",
    "@xfa-engine/pdf-node-linux-x64-gnu": "1.0.0-beta.1",
    "@xfa-engine/pdf-node-linux-x64-musl": "1.0.0-beta.1",
    "@xfa-engine/pdf-node-win32-x64-msvc": "1.0.0-beta.1"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0",
    "jest": "^30.3.0"
  }
}
