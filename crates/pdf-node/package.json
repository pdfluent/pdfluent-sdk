{
  "name": "@pdfluent/node",
  "version": "1.0.0",
  "description": "Enterprise PDF SDK for Node.js \u2014 find and replace PDF text while preserving fonts and layout, plus rendering, text extraction, forms, annotations, redaction, encryption, and PDF/A compliance.",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "LICENSE",
    "README.md"
  ],
  "napi": {
    "binaryName": "pdf-node",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">= 18"
  },
  "scripts": {
    "build": "napi build --release --platform && node scripts/build/postbuild.cjs",
    "build:debug": "napi build --platform && node scripts/build/postbuild.cjs",
    "postbuild:errors": "node scripts/build/postbuild.cjs",
    "test": "jest tests/ --testPathIgnorePatterns tests/license && jest tests/license.test.js && jest tests/license_signed_payload.test.js",
    "release:gen": "node scripts/release/generate-npm-dirs.cjs",
    "release:validate": "node scripts/release/validate-main-tarball.cjs",
    "release:publish": "bash scripts/release/publish.sh",
    "prepublishOnly": "node scripts/release/guard-prepublish.cjs"
  },
  "keywords": [
    "pdf",
    "pdf-text-replace",
    "find-and-replace",
    "edit-pdf-text",
    "render",
    "forms",
    "xfa",
    "acroform",
    "text-extraction",
    "pdf-a",
    "compliance",
    "annotations",
    "redaction",
    "encryption",
    "signature",
    "rust",
    "napi",
    "pdfluent"
  ],
  "license": "AGPL-3.0-only OR LicenseRef-PDFluent-Commercial",
  "licenseUrl": "https://pdfluent.com/terms",
  "repository": {
    "type": "git",
    "url": "https://github.com/pdfluent/pdfluent-sdk"
  },
  "homepage": "https://pdfluent.com",
  "bugs": {
    "url": "https://pdfluent.com/support"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@pdfluent/node-darwin-arm64": "1.0.0",
    "@pdfluent/node-darwin-x64": "1.0.0",
    "@pdfluent/node-linux-arm64-gnu": "1.0.0",
    "@pdfluent/node-linux-x64-gnu": "1.0.0",
    "@pdfluent/node-linux-x64-musl": "1.0.0",
    "@pdfluent/node-win32-x64-msvc": "1.0.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0",
    "jest": "^30.3.0"
  }
}
