<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- =========================================================== -->
  <!-- Coordinates                                                  -->
  <!-- =========================================================== -->
  <!-- ===========================================================
       DEPRECATED — DO NOT PUBLISH.
       This is the legacy `com.xfa.pdf` Java binding (artifactId
       `xfa-pdf`, MIT). It is fully superseded by the canonical Maven
       channel `bindings/java` (`com.pdfluent:pdfluent`, commercial
       license), which is what CI, the unified package auditor
       (`scripts/release/audit-all-packages.sh`), the publish train, and
       the consumer smoke target. It is retained only so the historic
       `com.xfa.pdf` sources still compile locally against the JNI native
       library (`libpdfluent_java`, built by the Rust crate `pdf-java`).
       Maven deploy is disabled below (maven-deploy-plugin skip + no
       distributionManagement) so this artifact can never be published.
       Canonical channel: bindings/java/pom.xml. See
       docs/reports/pdfluent_maven_channel_pom_reconciliation.md.
       =========================================================== -->
  <groupId>com.pdfluent</groupId>
  <artifactId>xfa-pdf</artifactId>
  <version>1.0.0-beta.1</version>
  <packaging>jar</packaging>

  <name>XFA PDF SDK (DEPRECATED — superseded by com.pdfluent:pdfluent)</name>
  <description>
    DEPRECATED legacy `com.xfa.pdf` Java binding. Not published. The
    supported Java SDK is `com.pdfluent:pdfluent` (bindings/java).
  </description>
  <url>https://github.com/pdfluent/pdfluent-sdk</url>

  <!-- =========================================================== -->
  <!-- License                                                      -->
  <!-- =========================================================== -->
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <!-- =========================================================== -->
  <!-- Developers                                                   -->
  <!-- =========================================================== -->
  <developers>
    <developer>
      <id>jasperdew</id>
      <name>Jasper de Winter</name>
      <url>https://gitlab.com/jasperdew</url>
    </developer>
  </developers>

  <!-- =========================================================== -->
  <!-- Source control                                               -->
  <!-- =========================================================== -->
  <scm>
    <connection>scm:git:git://github.com/pdfluent/pdfluent-sdk.git</connection>
    <developerConnection>scm:git:ssh://github.com/pdfluent/pdfluent-sdk.git</developerConnection>
    <url>https://github.com/pdfluent/pdfluent-sdk</url>
    <tag>HEAD</tag>
  </scm>

  <!-- =========================================================== -->
  <!-- Properties                                                   -->
  <!-- =========================================================== -->
  <properties>
    <java.version>11</java.version>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- Directory holding libpdfluent_java (the cdylib `cargo build -p pdf-java`
         produces). Defaults to a release build; CI builds debug and passes
         -Dnative.lib.dir=<workspace>/target/debug on the command line, which
         reaches the forked test JVM because it is interpolated into <argLine>
         below. A bare -Djava.library.path on the mvn command line does NOT
         reach it, Surefire says so itself in the log. -->
    <native.lib.dir>${project.basedir}/../../target/release</native.lib.dir>
  </properties>

  <!-- =========================================================== -->
  <!-- Dependencies                                                 -->
  <!-- =========================================================== -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- =========================================================== -->
  <!-- Build                                                        -->
  <!-- =========================================================== -->
  <build>
    <!--
      Java sources live at crates/pdf-java/java/ rather than the Maven
      default src/main/java/.
    -->
    <sourceDirectory>java</sourceDirectory>

    <plugins>

      <!-- Compiler -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.12.1</version>
        <configuration>
          <source>${java.version}</source>
          <target>${java.version}</target>
          <encoding>UTF-8</encoding>
        </configuration>
      </plugin>

      <!-- Surefire — JUnit 5 runner with native library path -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <argLine>-Djava.library.path=${native.lib.dir}</argLine>
          <!-- A run that finds no tests is a failure, not a pass. Without this
               a broken test-source layout prints "No tests to run" and exits 0,
               which is indistinguishable from green in a CI log. -->
          <failIfNoTests>true</failIfNoTests>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>

      <!-- Sources JAR (required by Maven Central) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.0</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Javadoc JAR (required by Maven Central) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.6.3</version>
        <configuration>
          <encoding>UTF-8</encoding>
          <doclint>none</doclint>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- DEPRECATED ARTIFACT — publish disabled.
           The Maven Central publish plumbing (GPG signing + Sonatype OSSRH
           nexus-staging) and the distribution-management section were removed
           so this legacy `xfa-pdf` artifact can never be deployed. `mvn deploy` is
           hard-disabled below via maven-deploy-plugin skip=true. The
           canonical, publishable Java artifact is `com.pdfluent:pdfluent`
           (bindings/java). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <version>3.1.2</version>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>

    </plugins>
  </build>

  <!--
    No distribution-management section: this deprecated artifact has no
    publish target by design. Canonical Maven channel is bindings/java/pom.xml
    (com.pdfluent:pdfluent). See
    docs/reports/pdfluent_maven_channel_pom_reconciliation.md.
  -->

</project>
